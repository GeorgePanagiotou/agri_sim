# Copy to .env locally (never commit your credentials).
# NASA Earthdata credentials: prefer ~/.netrc or earthaccess login.
# CDS API credentials: prefer ~/.cdsapirc.
# ESA Copernicus Data Space credentials (only if using Sentinel-2 Process API):
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# No private keys or passwords are included in the repository.
